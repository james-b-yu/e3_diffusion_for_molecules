{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug pretrained model",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main_qm9.py",
            "console": "integratedTerminal",
            "args": [
                "--resume",
                "outputs/pretrained_epoch_1240_bak",
                "--exp_name",
                "debugging pretrained model",
                "--start_epoch",
                "1241"
            ]
        },
        {
            "name": "Evaluate pretrained model",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/eval_analyze.py",
            "console": "integratedTerminal",
            "args": [
                "--model_path",
                "outputs/pretrained_epoch_1240_bak",
                "--exp_name",
                "debugging pretrained model",
            ]
        },
        {
            "name": "Resume qm7b",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main_qm9.py",
            "console": "integratedTerminal",
            "args": [
                "--resume",
                "outputs/edm_qm7b"
            ]
        },
        {
            "name": "QM9",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main_qm9.py",
            "console": "integratedTerminal",
            "args": [
                "--n_epochs",
                "3000",
                "--exp_name",
                "edm_qm9",
                "--n_stability_samples",
                "1000",
                "--diffusion_noise_schedule",
                "polynomial_2",
                "--diffusion_noise_precision",
                "1e-5",
                "--diffusion_steps",
                "1000",
                "--diffusion_loss_type",
                "l2",
                "--batch_size",
                "64",
                "--nf",
                "256",
                "--n_layers",
                "9",
                "--lr",
                "1e-4",
                "--normalize_factors",
                "[1,4,10]",
                "--test_epochs",
                "20",
                "--ema_decay",
                "0.9999"
            ]
        },
        {
            "name": "Resume Finetune",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main_qm9.py",
            "console": "integratedTerminal",
            "args": [
                "--resume",
                "outputs/edm_qm9_no_h_finetune_checkpoint",
                "--start_epoch",
                "1400"
            ]
        }
    ],
    "inputs": [
        {
            "id": "enterEpoch",
            "type": "promptString",
            "description": "Start epoch",
            "default": "0"
        }
    ]
}